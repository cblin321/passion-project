generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  password  String
  fileUsers FileUsers[]
}

model File {
  id        String          @id
  title     String          @map("title")
  fileUsers FileUsers[]
  access    AccessSpecifier @default(SHARED)
}

model FileUsers {
  userId Int
  fileId String
  role   Role
  file   File   @relation(fields: [fileId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, fileId])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum AccessSpecifier {
  PUBLIC
  SHARED
}
