generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  password  String
  fileUsers FileUsers[]
}

model File {
  id        Int         @id @default(autoincrement())
  name      String
  fileUsers FileUsers[]
}

model FileUsers {
  userId Int
  fileId Int
  role   Role
  file   File @relation(fields: [fileId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@id([userId, fileId])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}
